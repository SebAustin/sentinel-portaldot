# Portaldot Sentinel — environment template (no secrets in repo)

# Chain
PORTALDOT_WS_URL=ws://127.0.0.1:9944
PORTALDOT_SS58_FORMAT=42
PORTALDOT_TYPE_REGISTRY_PRESET=polkadot

# Demo multisig (dev accounts //Alice, //Bob, //Charlie)
MULTISIG_THRESHOLD=2
PROPOSER_SEED=//Alice

# Agent (optional — regex fallback when unset)
ANTHROPIC_API_KEY=

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PORTALDOT_WS=ws://127.0.0.1:9944
